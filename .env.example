# Optional settings for the lab. Copy this file to .env (git-ignored) and fill it in.

# The GitHub App that lets Argo CD report deployments to GitHub. See
# "Deploy status in GitHub" in the README. Leave GITHUB_APP_ID empty to skip.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=~/Downloads/your-app.2026-01-01.private-key.pem
