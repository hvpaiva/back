{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["application", "image"],
  "properties": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z]([a-z0-9-]{0,40}[a-z0-9])?$",
          "description": "The service's name: lowercase letters, digits and dashes."
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z]([a-z0-9-]{0,40}[a-z0-9])?$",
          "description": "The team that owns the service, which can read its namespaces: lowercase letters, digits and dashes."
        }
      }
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "The image to run, tag included."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "size": {
      "enum": ["small", "medium", "large"]
    },
    "public": {
      "type": "boolean"
    },
    "bucket": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "versioning": { "type": "boolean" }
      }
    },
    "database": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "size": { "enum": ["small", "medium", "large"] }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "domain": { "type": "string" },
        "route": { "enum": ["ingress", "gateway"] }
      }
    }
  }
}
